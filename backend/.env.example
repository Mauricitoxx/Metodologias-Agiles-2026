# Copiar este archivo como .env y ajustar si hace falta
APP_NAME=La Frikioteca API
ENVIRONMENT=development

# Base de datos local (SQLite). Para otra base, cambiar solo esta URL.
# Ejemplo PostgreSQL: postgresql+psycopg://usuario:clave@localhost:5432/frikioteca
DATABASE_URL=sqlite:///./frikioteca.db

# Orígenes permitidos para CORS, separados por coma (Vite usa el puerto 5173)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
